---
import { site } from '../site';

interface Props {
  /** Prefix for section links: '' on the home page, '/' elsewhere. */
  base?: string;
}
const { base = '' } = Astro.props;
const sections = [
  { id: 'work', label: 'Work' },
  { id: 'value', label: 'How I help' },
  { id: 'experience', label: 'Experience' },
  { id: 'about', label: 'About' },
];
---
<header class="panel">
  <div class="panel__top">
    <div class="panel__id">
      <img class="panel__photo" src={site.photo} alt="" width="64" height="64" decoding="async" />
      <div class="panel__idtext">
        <a class="panel__name" href="/" data-cursor="Home">{site.name}</a>
        <span class="panel__role">{site.role}</span>
      </div>
    </div>
    <p class="panel__intro">
      A product designer who actually <em>likes meetings.</em> {site.intro}
    </p>
  </div>

  <nav class="nav" aria-label="Sections">
    {
      sections.map((s, i) => (
        <a href={`${base}#${s.id}`} data-spy={s.id} data-cursor={`Go to ${s.label}`} aria-current={i === 0 && base === '' ? 'true' : 'false'}>
          <span class="nav__bar" aria-hidden="true" />
          <span class="nav__num" aria-hidden="true">{`0${i + 1}`}</span>
          {s.label}
        </a>
      ))
    }
  </nav>

  <div class="panel__foot">
    <ul class="facts">
      <li class="status">{site.status}</li>
      <li>Based in {site.location}<time class="panel__clock" data-clock={site.timeZone}></time></li>
      <li>{site.relocation}</li>
    </ul>
    <div class="contact">
      {site.email && <a href={`mailto:${site.email}`} data-cursor="Email Jan">Email</a>}
      <a href={site.linkedin} rel="me noopener" target="_blank" data-cursor="Open LinkedIn">LinkedIn ↗</a>
      {site.resume && <a href={site.resume}>Resume ↗</a>}
      <div class="seg" role="group" aria-label="Appearance">
        <button type="button" data-theme-set="light" aria-pressed="false" data-cursor="Light mode">Light</button>
        <button type="button" data-theme-set="dark" aria-pressed="false" data-cursor="Dark mode">Dark</button>
      </div>
    </div>
  </div>
</header>

<script>
  // Jan's local time, e.g. "3:51 PM". Static HTML shows nothing until this runs.
  document.querySelectorAll<HTMLTimeElement>('[data-clock]').forEach((el) => {
    const fmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: el.dataset.clock });
    const tick = () => (el.textContent = ` · ${fmt.format(new Date())}`);
    tick();
    setInterval(tick, 30_000);
  });
</script>
