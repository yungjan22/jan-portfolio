---
import { site } from '../site';

interface Props {
  /** Prefix for section links: '' on the home page, '/' elsewhere. */
  base?: string;
}
const { base = '' } = Astro.props;
const sections = [
  { id: 'work', label: 'Work' },
  { id: 'value', label: 'How I help' },
  { id: 'experience', label: 'Experience' },
  { id: 'about', label: 'About' },
];
---
<header class="panel">
  <div class="panel__id">
    <a class="panel__name" href="/">{site.name}</a>
    <span class="panel__role">
      {site.role} · {site.location}
      <time class="panel__clock" data-clock={site.timeZone}></time>
    </span>
  </div>
  <h1 class="panel__headline">A product designer who actually <i>likes meetings.</i></h1>
  <p class="panel__intro">
    I enjoy conversations with project managers, researchers, engineers and stakeholders. And I
    design things that ship.
  </p>

  <nav class="nav" aria-label="Sections">
    {
      sections.map((s, i) => (
        <a href={`${base}#${s.id}`} data-spy={s.id} aria-current={i === 0 && base === '' ? 'true' : 'false'}>
          <span class="nav__bar" aria-hidden="true" />
          <span class="nav__num" aria-hidden="true">{`0${i + 1}`}</span>
          {s.label}
        </a>
      ))
    }
  </nav>

  <div class="panel__foot">
    <span class="status">{site.status}</span>
    <div class="contact">
      {site.email && <a href={`mailto:${site.email}`}>Email</a>}
      <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a>
      {site.resume && <a href={site.resume}>Resume ↗</a>}
    </div>
    <div class="appearance" role="group" aria-label="Appearance">
      Appearance
      <div class="seg">
        <button type="button" data-theme-set="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
      </div>
    </div>
  </div>
</header>

<script>
  // Jan's local time, e.g. "3:51 PM". Static HTML shows nothing until this runs.
  document.querySelectorAll<HTMLTimeElement>('[data-clock]').forEach((el) => {
    const fmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: el.dataset.clock });
    const tick = () => (el.textContent = ` · ${fmt.format(new Date())}`);
    tick();
    setInterval(tick, 30_000);
  });
</script>
