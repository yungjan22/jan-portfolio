---
// GitHub Spark concept 3, half row: "Customize Spark". While in view, the
// coding-experience dropdown opens, the next level is picked, and it closes again,
// cycling through all three levels. Reduced motion shows the first level, still.
const levels = [
  'I’m new to coding or rarely write code',
  'I can read code and make small edits',
  'I write code most days',
];
---
<div class="sl" data-sl-play>
  <div class="sl-panel" role="img" aria-label="Customize Spark: a dropdown for your coding experience, from I'm new to coding or rarely write code, to I can read code and make small edits, to I write code most days">
    <div class="sl-field" aria-hidden="true">
      <p class="sl-label">How would you describe your coding experience?</p>
      <div class="sl-select">
        <span class="sl-value">
          {levels.map((l, i) => <span class:list={{ 'is-on': i === 0 }}>{l}</span>)}
        </span>
        <svg viewBox="0 0 12 12" width="10" height="10"><path d="M2 4h8L6 8.5Z" /></svg>
        <div class="sl-menu">
          {levels.map((l, i) => <span class:list={['sl-opt', { 'is-on': i === 0 }]}>{l}</span>)}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .sl { height: 380px; display: flex; align-items: center; justify-content: center; padding: 40px 72px; background: var(--stage) url('/work/github-spark/concept-level-bg.webp') center / cover no-repeat; }
  .sl-panel {
    width: 100%; max-width: 260px; margin-bottom: 96px; color: var(--ink);
    font-family: var(--font-sans); font-size: var(--text-label);
  }
  .sl-label {
    display: inline-block; font-weight: 600; font-size: var(--text-label); margin-bottom: var(--space-2); padding: 6px 10px; border-radius: 6px;
    background: var(--chart-card); backdrop-filter: blur(6px);
  }
  .sl-select {
    position: relative; display: flex; align-items: center; gap: var(--space-2); padding: 10px 12px; border-radius: 6px;
    background: var(--chart-card); border: 1px solid var(--chart-card-line); backdrop-filter: blur(6px);
  }
  .sl-select > svg { fill: var(--ink); flex: none; }
  .sl-value { flex: 1; min-width: 0; display: grid; font-size: var(--text-tag); }
  .sl-value > span {
    grid-area: 1 / 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    opacity: 0; transition: opacity 200ms ease;
  }
  .sl-value > span.is-on { opacity: 1; }

  .sl-menu {
    position: absolute; z-index: 1; top: calc(100% + 4px); left: 0; right: 0; display: flex; flex-direction: column;
    padding: 4px; border-radius: 6px; background: var(--surface); border: 1px solid var(--chart-card-line); font-size: var(--text-tag);
    transform-origin: top; opacity: 0; transform: scaleY(0.9); pointer-events: none;
    transition: opacity 200ms ease, transform 200ms ease;
  }
  .is-open .sl-menu { opacity: 1; transform: none; }
  .sl-opt { padding: 8px; border-radius: 4px; transition: background-color 200ms ease; }
  .sl-opt.is-on { background: color-mix(in srgb, var(--chart-1) 18%, transparent); }

  @media (prefers-reduced-motion: reduce) {
    .sl * { transition: none !important; }
  }

  @media (max-width: 899px) {
    .sl { height: 100%; min-height: 320px; padding: 32px 28px; }
  }
</style>

<script>
  // Every 3s while visible: open the menu, move the highlight to the next level,
  // then close with that level chosen. Stops (and resets) when out of view.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-sl-play]').forEach((el) => {
    const values = [...el.querySelectorAll<HTMLElement>('.sl-value > span')];
    const opts = [...el.querySelectorAll<HTMLElement>('.sl-opt')];
    let i = 0;
    let timer: number | undefined;
    const show = (n: number, list: HTMLElement[]) => list.forEach((x, k) => x.classList.toggle('is-on', k === n));
    const step = () => {
      const next = (i + 1) % values.length;
      el.classList.add('is-open');
      setTimeout(() => show(next, opts), 600);
      setTimeout(() => {
        show(next, values);
        el.classList.remove('is-open');
        i = next;
      }, 1300);
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !timer && !still.matches) {
        timer = window.setInterval(step, 3000);
      } else if (!e.isIntersecting) {
        clearInterval(timer);
        timer = undefined;
        el.classList.remove('is-open');
        i = 0;
        show(0, values);
        show(0, opts);
      }
    }, { threshold: 0.5 }).observe(el);
  });
</script>
