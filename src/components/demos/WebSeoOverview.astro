---
// Web SEO hero: just the pieces of a simplified, unbranded search result that tell
// the GEO win, floating on the stage image (no container): the search box, the
// AI Overview with the firm named in it, and the firm's link card on the side.
// Static on purpose (no entry animation) and kept sparse.
// Reference: design-assets/web-seo-ai-overview-reference.jpg.
// Edit the words here:
const query = 'Detained after entering customs';
const firm = 'Law firm';
const domain = 'lawfirm.com';
---
<div class="seo-demo">
  <svg viewBox="0 0 600 190" role="img" aria-label={`Search for "${query}": the AI Overview names the ${firm} and links to it on the side.`} xmlns="http://www.w3.org/2000/svg">
    <!-- Search field -->
    <rect class="so-field" x="0" y="0" width="600" height="46" rx="23" />
    <circle class="so-icon" cx="27" cy="21.5" r="7" />
    <path class="so-icon" d="M32.5 27 l5.5 5.5" />
    <text class="so-query" x="50" y="29">{query}</text>
    <path class="so-icon" d="M566 18 l10 10 M576 18 l-10 10" />

    <!-- AI Overview -->
    <path class="so-spark" d="M10 76 C11.3 81.4 12.4 82.5 17.6 83.9 C12.4 85.3 11.3 86.4 10 91.8 C8.7 86.4 7.6 85.3 2.4 83.9 C7.6 82.5 8.7 81.4 10 76Z" />
    <text class="so-label" x="26" y="89">AI Overview</text>

    <rect class="so-line" x="0" y="110" width="372" height="10" rx="5" />
    <rect class="so-hit-bg" x="0" y="130" width="90" height="24" rx="6" />
    <text class="so-hit" x="11" y="147">{firm}</text>
    <rect class="so-line" x="100" y="137" width="272" height="10" rx="5" />
    <rect class="so-line" x="0" y="166" width="300" height="10" rx="5" />

    <!-- Source card, linked on the side -->
    <rect class="so-source" x="404" y="106" width="196" height="72" rx="10" />
    <rect class="so-fav" x="418" y="120" width="20" height="20" rx="4" />
    <text class="so-source-name" x="448" y="135.5">{firm}</text>
    <text class="so-source-link" x="418" y="163">{domain} ↗</text>
  </svg>
</div>

<style>
  .seo-demo { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 8% 10%; }
  .seo-demo svg { width: 100%; height: 100%; max-width: 600px; overflow: visible; font-family: var(--font-sans); }

  .so-field { fill: var(--chart-chip); stroke: var(--chart-card-line); }
  .so-icon { fill: none; stroke: var(--chart-muted); stroke-width: 1.8; stroke-linecap: round; }
  .so-query { fill: var(--ink); font-size: 17px; font-weight: 500; }
  /* Pieces that sit straight on the stage image use --on-stage. */
  .so-spark { fill: var(--on-stage); }
  .so-label { fill: var(--on-stage); font-size: 15px; font-weight: 700; }
  .so-line { fill: var(--on-stage); opacity: 0.32; }
  .so-hit-bg { fill: var(--chart-chip); stroke: var(--ember); stroke-width: 1.4; }
  .so-hit { fill: var(--chart-accent-text); font-size: 14px; font-weight: 700; }
  .so-source { fill: var(--chart-chip); stroke: var(--ember); stroke-width: 1.6; }
  .so-fav { fill: var(--ember); }
  .so-source-name { fill: var(--ink); font-size: 15px; font-weight: 700; }
  .so-source-link { fill: var(--chart-accent-text); font-size: 13px; font-weight: 600; }
</style>
