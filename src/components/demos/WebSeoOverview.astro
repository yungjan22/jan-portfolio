---
// Web SEO hero: a simplified, unbranded search result that shows the GEO win.
// The firm is named inside the AI Overview with its link on the side, while the
// "#1 organic result" fades out below the fold. Static on purpose (no entry
// animation) and kept sparse. Reference: design-assets/web-seo-ai-overview-reference.jpg.
// Edit the words here:
const query = 'Detained after entering customs';
const firm = 'Law firm';
const domain = 'lawfirm.com';
const uid = `seo-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="seo-demo">
  <svg viewBox="0 0 600 340" role="img" aria-label={`Search for "${query}": the AI Overview names the ${firm} and links to it on the side, above the first organic result.`} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={`${uid}-fade`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="1" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <mask id={`${uid}-mask`} maskUnits="userSpaceOnUse" x="0" y="246" width="600" height="94">
        <rect x="0" y="246" width="600" height="94" fill={`url(#${uid}-fade)`} />
      </mask>
    </defs>

    <rect class="so-panel" x="0" y="0" width="600" height="340" rx="16" />

    <!-- Search field -->
    <rect class="so-field" x="24" y="22" width="552" height="42" rx="21" />
    <circle class="so-icon" cx="49" cy="41.5" r="6.5" />
    <path class="so-icon" d="M54 46.5 l5 5" />
    <text class="so-query" x="70" y="48.5">{query}</text>
    <path class="so-icon" d="M548 37 l9 9 M557 37 l-9 9" />

    <!-- Tabs -->
    <text class="so-tab so-tab--on" x="24" y="96">All</text>
    <rect class="so-tab-bar" x="24" y="104" width="18" height="2" />
    <text class="so-tab" x="62" y="96">News</text>
    <text class="so-tab" x="112" y="96">Images</text>
    <text class="so-tab" x="170" y="96">Videos</text>
    <line class="so-rule" x1="0" x2="600" y1="106" y2="106" />

    <!-- AI Overview -->
    <path class="so-spark" d="M34 124 C35.2 129 36.2 130 41 131.3 C36.2 132.6 35.2 133.6 34 138.6 C32.8 133.6 31.8 132.6 27 131.3 C31.8 130 32.8 129 34 124Z" />
    <text class="so-label" x="48" y="136">AI Overview</text>

    <rect class="so-line" x="24" y="152" width="360" height="10" rx="5" />
    <rect class="so-hit-bg" x="24" y="170" width="86" height="22" rx="6" />
    <text class="so-hit" x="34" y="185.5">{firm}</text>
    <rect class="so-line" x="118" y="176" width="266" height="10" rx="5" />
    <rect class="so-line" x="24" y="200" width="300" height="10" rx="5" />

    <!-- Source card, linked on the side -->
    <rect class="so-source" x="404" y="148" width="172" height="66" rx="10" />
    <rect class="so-fav" x="416" y="160" width="18" height="18" rx="4" />
    <text class="so-source-name" x="442" y="174">{firm}</text>
    <text class="so-source-link" x="416" y="200">{domain} ↗</text>

    <!-- #1 organic result, fading out below the fold -->
    <g mask={`url(#${uid}-mask)`}>
      <line class="so-rule" x1="24" x2="576" y1="236" y2="236" />
      <text class="so-organic" x="24" y="266">#1 organic search result</text>
      <rect class="so-line so-line--faint" x="24" y="280" width="552" height="9" rx="4.5" />
      <rect class="so-line so-line--faint" x="24" y="297" width="460" height="9" rx="4.5" />
      <rect class="so-line so-line--faint" x="24" y="314" width="520" height="9" rx="4.5" />
    </g>
  </svg>
</div>

<style>
  .seo-demo { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 6% 8%; }
  .seo-demo svg { width: 100%; height: 100%; max-width: 640px; font-family: var(--font-sans); }

  .so-panel { fill: var(--chart-card); stroke: var(--chart-card-line); }
  .so-field { fill: var(--chart-chip); stroke: var(--chart-card-line); }
  .so-icon { fill: none; stroke: var(--muted); stroke-width: 1.8; stroke-linecap: round; }
  .so-query { fill: var(--ink); font-size: 16px; font-weight: 500; }
  .so-tab { fill: var(--muted); font-size: 12.5px; font-weight: 500; }
  .so-tab--on { fill: var(--ink); font-weight: 700; }
  .so-tab-bar { fill: var(--ink); }
  .so-rule { stroke: var(--chart-card-line); stroke-width: 1; }
  .so-spark { fill: var(--chart-4); }
  .so-label { fill: var(--ink); font-size: 13px; font-weight: 700; }
  .so-line { fill: var(--chart-card-line); }
  .so-line--faint { opacity: 0.8; }
  .so-hit-bg { fill: var(--col-hot); stroke: var(--ember); stroke-width: 1.2; }
  .so-hit { fill: var(--ember-text); font-size: 13px; font-weight: 700; }
  .so-source { fill: var(--chart-chip); stroke: var(--ember); stroke-width: 1.4; }
  .so-fav { fill: var(--ember); }
  .so-source-name { fill: var(--ink); font-size: 13.5px; font-weight: 700; }
  .so-source-link { fill: var(--ember-text); font-size: 12px; font-weight: 600; }
  .so-organic { fill: var(--chart-1); font-size: 15px; font-weight: 500; }
</style>
