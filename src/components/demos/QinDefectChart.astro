---
// QinSight "Defect Rate" panel, rebuilt as an animated SVG from Jan's dashboard
// screenshot (design-assets/qinsight-defect-rate-reference.jpg). Values are read
// off that screenshot. Colours are retoned to the portfolio (--chart-* tokens).
// Sequence: frosted card rises in → the four metric chips rise in →
// grid and thresholds fade in → lines draw left to right with their points →
// the latest points keep a slow pulse. Static with reduced motion.

const W = 740;
const H = 380;
const x0 = 30;
const x1 = 664;
const yAt = (v: number) => 350 - v * 22; // 0% → 350, 8% → 174
const hours = [8, 10, 12, 14, 16, 18];
const xAt = (i: number) => x0 + (i * (x1 - x0)) / (hours.length - 1);

const series = [
  { key: 'wings', label: 'Wings Defect (%)', color: 'var(--chart-1)', values: [1.8, 2.0, 2.4, 2.1, 1.3, 1.1] },
  { key: 'head', label: 'Head Defect (%)', color: 'var(--chart-2)', values: [0.6, 0.7, 0.6, 1.4, 0.8, 0.5] },
  { key: 'breast', label: 'Bruised Breast (%)', color: 'var(--chart-3)', values: [3.1, 3.4, 3.8, 4.5, 4.3, 4.6] },
  { key: 'hooks', label: 'Empty Hooks (%)', color: 'var(--chart-4)', values: [5.6, 4.8, 4.5, 3.3, 3.7, 3.3] },
];
const thresholds = [
  { v: 5, color: 'var(--chart-4)' },
  { v: 3, color: 'var(--chart-4)' },
  { v: 4, color: 'var(--chart-3)' },
  { v: 2, color: 'var(--chart-3)' },
];
const path = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${xAt(i).toFixed(1)} ${yAt(v).toFixed(1)}`).join(' ');
const chipW = 162;
const chipGap = 12;
---
<div class="qin-demo" data-demo-play>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="QinSight dashboard: Defect Rate today. Four lines for wings, head, bruised breast and empty hooks, all within normal range." xmlns="http://www.w3.org/2000/svg">
    <g class="qd-card">
      <rect class="qd-panel" x="0" y="0" width={W} height={H} rx="12" />

      <text class="qd-title" x="28" y="46">Defect Rate</text>
      <text class="qd-muted qd-today" x="666" y="45" text-anchor="end">Today</text>
      <path class="qd-caret" d="M676 38 l6 7 l6 -7 z" />

      {
        series.map((s, i) => {
          const x = 28 + i * (chipW + chipGap);
          return (
            <g class="qd-chip" style={`--i:${i}`}>
              <rect class="qd-chip-bg" x={x} y="70" width={chipW} height="56" rx="5" />
              <rect x={x} y="70" width="4" height="56" style={`fill:${s.color}`} />
              <text class="qd-chip-label" x={x + 16} y="93">{s.label}</text>
              <circle class="qd-info" cx={x + chipW - 14} cy="88.5" r="5.5" />
              <path class="qd-info-i" d={`M${x + chipW - 14} 87 v4.5 M${x + chipW - 14} 85.4 v.2`} />
              <circle class="qd-ok" cx={x + 23} cy="111" r="6.5" />
              <path class="qd-ok-tick" d={`M${x + 19.8} 111.2 l2.2 2.2 l4.2 -4.6`} />
              <text class="qd-ok-text" x={x + 35} y="116">Normal</text>
            </g>
          );
        })
      }

      <g class="qd-grid">
        {[8, 6, 4, 2].map((v) => (
          <>
            <line x1={x0 - 6} x2={x1 + 16} y1={yAt(v)} y2={yAt(v)} />
            <text class="qd-axis" x="712" y={yAt(v) + 4} text-anchor="end">{v}%</text>
          </>
        ))}
        <line x1={x0 - 6} x2={x1 + 16} y1={yAt(0)} y2={yAt(0)} />
        <text class="qd-axis" x="712" y={yAt(0) + 4} text-anchor="end">0</text>
        {hours.map((h, i) => (
          <text class="qd-axis" x={xAt(i)} y="372" text-anchor="middle">{h}</text>
        ))}
        {thresholds.map((t) => (
          <line class="qd-threshold" x1={x0 - 6} x2={x1 + 16} y1={yAt(t.v)} y2={yAt(t.v)} style={`stroke:${t.color}`} />
        ))}
      </g>

      {
        series.map((s, i) => (
          <g class="qd-series" style={`--i:${i}; --c:${s.color}`}>
            <path class="qd-line" d={path(s.values)} pathLength="1" />
            {s.values.map((v, j) => (
              <circle class="qd-dot" cx={xAt(j)} cy={yAt(v)} r="6" style={`--j:${j}`} />
            ))}
            <circle class="qd-pulse" cx={xAt(5)} cy={yAt(s.values[5])} r="6" />
          </g>
        ))
      }
    </g>
  </svg>
</div>

<style>
  .qin-demo { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 5% 6%; }
  .qin-demo svg { width: 100%; height: 100%; max-width: 760px; overflow: visible; font-family: var(--font-sans); }

  .qd-panel { fill: var(--chart-card); stroke: var(--chart-card-line); }
  .qd-title { fill: var(--ink); font-size: 24px; font-weight: 500; }
  .qd-muted, .qd-axis { fill: var(--muted); }
  .qd-today { font-size: 16px; }
  .qd-caret { fill: var(--muted); }
  .qd-chip-bg { fill: var(--chart-chip); stroke: var(--chart-card-line); }
  .qd-chip-label { fill: var(--ink); font-size: 13.5px; font-weight: 500; }
  .qd-info { fill: none; stroke: var(--muted); stroke-width: 1.2; }
  .qd-info-i { stroke: var(--muted); stroke-width: 1.4; stroke-linecap: round; }
  .qd-ok { fill: none; stroke: var(--chart-ok); stroke-width: 1.6; }
  .qd-ok-tick { fill: none; stroke: var(--chart-ok); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .qd-ok-text { fill: var(--chart-ok); font-size: 14px; font-weight: 500; }
  .qd-axis { font-size: 13px; font-variant-numeric: tabular-nums; }
  .qd-grid line { stroke: var(--chart-card-line); stroke-width: 1; }
  .qd-grid .qd-threshold { stroke-width: 1.4; stroke-dasharray: 5 5; opacity: 0.45; }
  .qd-line { fill: none; stroke: var(--c); stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
  .qd-dot { fill: var(--c); }
  .qd-pulse { fill: none; stroke: var(--c); stroke-width: 2; opacity: 0; }
  .qd-card, .qd-chip, .qd-dot, .qd-pulse { transform-box: fill-box; transform-origin: center; }

  /* Hidden until it plays. */
  .qin-demo:not(.is-playing) :is(.qd-card, .qd-chip, .qd-grid, .qd-dot) { opacity: 0; }
  .qin-demo:not(.is-playing) .qd-line { stroke-dasharray: 1; stroke-dashoffset: 1; }

  .is-playing .qd-card { animation: qd-rise 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .is-playing .qd-chip { animation: qd-rise 500ms cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(250ms + var(--i) * 90ms); }
  .is-playing .qd-grid { animation: qd-fade 500ms ease both 550ms; }
  .is-playing .qd-line {
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: qd-draw 1300ms cubic-bezier(0.45, 0, 0.2, 1) both; animation-delay: calc(800ms + var(--i) * 140ms);
  }
  .is-playing .qd-dot {
    animation: qd-pop 360ms cubic-bezier(0.3, 1.5, 0.5, 1) both;
    animation-delay: calc(800ms + var(--i) * 140ms + var(--j) * 240ms);
  }
  .is-playing .qd-pulse { animation: qd-pulse 2.6s ease-out infinite; animation-delay: calc(2.6s + var(--i) * 0.65s); }

  @keyframes qd-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes qd-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes qd-draw { to { stroke-dashoffset: 0; } }
  @keyframes qd-pop { from { opacity: 0; transform: scale(0); } to { opacity: 1; transform: none; } }
  @keyframes qd-pulse {
    0% { opacity: 0.55; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(2.3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .qin-demo :is(.qd-card, .qd-chip, .qd-grid, .qd-dot) { opacity: 1 !important; animation: none !important; }
    .qin-demo .qd-line { stroke-dashoffset: 0 !important; animation: none !important; }
    .qin-demo .qd-pulse { animation: none !important; }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
    },
    { threshold: 0.35 },
  );
  document.querySelectorAll('.qin-demo[data-demo-play]').forEach((el) => io.observe(el));
</script>
