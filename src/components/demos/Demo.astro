---
// Coded animations that can stand in for a case study's hero image.
// Use in frontmatter as: heroDemo: <name>
import SparkLogo from './SparkLogo.astro';
import QinDefectChart from './QinDefectChart.astro';
import WebSeoOverview from './WebSeoOverview.astro';
import QinAlert from './QinAlert.astro';
import SparkModes from './SparkModes.astro';
import SparkSelect from './SparkSelect.astro';
import SparkLevel from './SparkLevel.astro';

const demos = { 'spark-logo': SparkLogo, 'qin-defect-chart': QinDefectChart, 'web-seo-overview': WebSeoOverview, 'qin-alert': QinAlert, 'spark-modes': SparkModes, 'spark-select': SparkSelect, 'spark-level': SparkLevel } as const;
export type DemoName = keyof typeof demos;

interface Props {
  name: string;
}
const Component = demos[Astro.props.name as DemoName];
---
{Component ? <Component /> : <span>[Unknown demo: {Astro.props.name}]</span>}
