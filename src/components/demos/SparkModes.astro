---
// GitHub Spark concept 1, full row: the Iterate / Explain switch. Plays once when it
// scrolls into view: starts in Iterate, then the switch slides to Explain and the
// suggested question and input change with it. Reduced motion shows Explain only.
---
<div class="sm demo-stage" data-sm-play>
  <div class="sm-panel" role="img" aria-label="Spark panel switching from Iterate mode, which changes your app, to Explain mode, which answers questions without editing it">
    <div class="sm-switch" aria-hidden="true">
      <span class="sm-thumb"></span>
      <span class="sm-tab sm-tab--iterate">
        <svg viewBox="0 0 16 16" width="14" height="14"><path d="M8 1.5 9.6 6.4 14.5 8 9.6 9.6 8 14.5 6.4 9.6 1.5 8 6.4 6.4Z" /></svg>
        Iterate
      </span>
      <span class="sm-tab sm-tab--explain">
        <svg viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="6.2" fill="none" stroke-width="1.5" /><path d="M8 7.2v4" stroke-width="1.6" stroke-linecap="round" /><circle cx="8" cy="4.9" r="0.9" /></svg>
        Explain
      </span>
    </div>

    <div class="sm-body" aria-hidden="true">
      <div class="sm-mode sm-mode--iterate">
        <p class="sm-hint">Changes your app</p>
        <span class="sm-chip"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M5.6 11.2h4.8M6.4 13.6h3.2M8 2a4.2 4.2 0 0 0-2.4 7.6v1.6h4.8V9.6A4.2 4.2 0 0 0 8 2Z" /></svg>Add a search bar to the top</span>
        <span class="sm-input">Describe a change to your app…</span>
      </div>
      <div class="sm-mode sm-mode--explain">
        <p class="sm-hint">Answers without editing</p>
        <span class="sm-chip"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M5.6 11.2h4.8M6.4 13.6h3.2M8 2a4.2 4.2 0 0 0-2.4 7.6v1.6h4.8V9.6A4.2 4.2 0 0 0 8 2Z" /></svg>Where is my flashcard data stored?</span>
        <span class="sm-input">Ask without editing your app…</span>
      </div>
    </div>
  </div>
</div>

<style>
  .sm { height: 400px; display: flex; align-items: center; justify-content: center; padding: 48px 72px; background-color: var(--stage); }
  .sm-panel {
    width: 100%; max-width: 520px; padding: var(--space-5); border-radius: 12px;
    background: var(--chart-card); border: 1px solid var(--chart-card-line); color: var(--ink);
    font-family: var(--font-sans); font-size: var(--text-small); backdrop-filter: blur(6px);
  }

  /* Segmented switch: the thumb slides from Iterate to Explain */
  .sm-switch {
    position: relative; display: grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 8px;
    background: var(--chart-chip); border: 1px solid var(--chart-card-line);
  }
  .sm-thumb {
    position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 6px;
    background: var(--surface); border: 1px solid var(--chart-card-line);
  }
  .sm-tab {
    position: relative; display: flex; align-items: center; justify-content: center; gap: 6px;
    padding: 10px 0; font-weight: 600; color: var(--chart-muted);
  }
  .sm-tab svg { fill: currentColor; stroke: currentColor; }
  .sm-tab--iterate svg { stroke: none; }

  /* Both modes share one grid cell and crossfade */
  .sm-body { display: grid; margin-top: var(--space-5); }
  .sm-mode { grid-area: 1 / 1; display: flex; flex-direction: column; gap: var(--space-3); }
  .sm-hint { font-size: var(--text-tag); color: var(--chart-muted); }
  .sm-chip {
    align-self: flex-start; display: flex; align-items: center; gap: var(--space-2); padding: 8px 12px; border-radius: 6px;
    background: color-mix(in srgb, var(--chart-3) 18%, transparent); color: var(--ink);
  }
  .sm-chip svg { fill: none; stroke: var(--chart-3); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .sm-input {
    display: block; margin-top: var(--space-2); padding: 14px var(--space-4); border-radius: 8px;
    border: 1px solid var(--chart-card-line); background: var(--chart-chip); color: var(--chart-muted);
  }

  /* Resting state (before it plays): Iterate */
  .sm-tab--iterate { color: var(--ink); }
  .sm-mode--explain { opacity: 0; }

  .is-playing .sm-thumb { animation: sm-slide 420ms cubic-bezier(0.4, 0, 0.2, 1) 1400ms both; }
  .is-playing .sm-tab--iterate { animation: sm-dim 420ms ease 1400ms both; }
  .is-playing .sm-tab--explain { animation: sm-lit 420ms ease 1400ms both; }
  .is-playing .sm-mode--iterate { animation: sm-out 260ms ease 1450ms both; }
  .is-playing .sm-mode--explain { animation: sm-in 360ms ease 1650ms both; }

  @keyframes sm-slide { to { transform: translateX(100%); } }
  @keyframes sm-dim { to { color: var(--chart-muted); } }
  @keyframes sm-lit { to { color: var(--ink); } }
  @keyframes sm-out { to { opacity: 0; transform: translateY(-6px); } }
  @keyframes sm-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .sm .sm-thumb { transform: translateX(100%); animation: none !important; }
    .sm .sm-tab--iterate { color: var(--chart-muted); animation: none !important; }
    .sm .sm-tab--explain { color: var(--ink); animation: none !important; }
    .sm .sm-mode--iterate { opacity: 0; animation: none !important; }
    .sm .sm-mode--explain { opacity: 1; animation: none !important; }
  }

  @media (max-width: 899px) {
    .sm { height: auto; padding: 32px 24px; }
  }
</style>

<script>
  // Play when visible; reset when out of view so it replays next time.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
    },
    { threshold: 0.5 },
  );
  document.querySelectorAll('[data-sm-play]').forEach((el) => io.observe(el));
</script>
