  <svg viewBox="0 0 520 353" role="img" aria-label="GitHub Spark logo" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <clipPath id={`${uid}-wipe`}>
        <rect class="sd-wipe" x="0" y="270" width="520" height="90" />
      </clipPath>
    </defs>
