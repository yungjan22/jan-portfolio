<style>
  .spark-demo { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 8% 10%; }
  .spark-demo svg { width: 100%; height: 100%; max-width: 440px; overflow: visible; }
  .sd-word, .sd-mark { fill: var(--on-stage); }
  .sd-mark, .sd-star { transform-box: fill-box; transform-origin: center; }

  /* Before playing: hidden. Reduced motion skips straight to the final state. */
  .spark-demo:not(.is-playing) .sd-mark,
  .spark-demo:not(.is-playing) .sd-star { opacity: 0; }
  .spark-demo:not(.is-playing) .sd-wipe { width: 0; }

  .is-playing .sd-mark { animation: sd-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .is-playing .sd-wipe { animation: sd-wipe 900ms cubic-bezier(0.5, 0, 0.2, 1) 450ms both; }
  .is-playing .sd-star { animation: sd-pop 520ms cubic-bezier(0.3, 1.6, 0.5, 1) both; }
  .is-playing .sd-star--big { animation-delay: 1050ms; --sd-turn: -40deg; }
  .is-playing .sd-star--dot { animation-delay: 1250ms; }
  .is-playing .sd-star--square { animation-delay: 1400ms; --sd-turn: 45deg; }
  .is-playing .sd-star--small { animation-delay: 1550ms; --sd-turn: 30deg; }
  .is-playing .sd-star--small {
    animation: sd-pop 520ms cubic-bezier(0.3, 1.6, 0.5, 1) 1550ms both, sd-twinkle 3.2s ease-in-out 2.4s infinite;
  }

  @keyframes sd-rise {
    from { opacity: 0; transform: translateY(14px) scale(0.94); }
    to { opacity: 1; transform: none; }
  }
  @keyframes sd-wipe {
    from { width: 0; }
    to { width: 520px; }
  }
  @keyframes sd-pop {
    from { opacity: 0; transform: scale(0) rotate(var(--sd-turn, 0deg)); }
    to { opacity: 1; transform: none; }
  }
  @keyframes sd-twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(0.8) rotate(45deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .spark-demo .sd-mark, .spark-demo .sd-star { opacity: 1 !important; animation: none !important; }
    .spark-demo .sd-wipe { width: 520px !important; animation: none !important; }
  }
</style>

<script>
  // Play when visible; reset when out of view so it replays next time
  // (including when its project profile opens in the lightbox).
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
    },
    { threshold: 0.35 },
  );
  document.querySelectorAll('[data-demo-play]').forEach((el) => io.observe(el));
</script>
