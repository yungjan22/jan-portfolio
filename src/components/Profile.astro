---
// The Hinge-style project profile. Used in the lightbox and atop each case study page.
// Small title, big one-line answers; facts grouped in one row near the top.
import type { CollectionEntry } from 'astro:content';
import Shot from './Shot.astro';
import Demo from './demos/Demo.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  headingId?: string;
  headingLevel?: 'h1' | 'h2';
}
const { entry, headingId, headingLevel = 'h2' } = Astro.props;
const d = entry.data;
const stageName = d.stage[0].toUpperCase() + d.stage.slice(1);
const Heading = headingLevel;
const join = (a?: string, b?: string, sep = ', ') => [a, b].filter(Boolean).join(sep);
const basics = [
  { label: 'My role', value: join(d.roleTitle, d.led, ' · ') },
  { label: 'Team', value: join(d.team, d.teamSub) },
  { label: 'Timeline', value: join(d.timeline, d.timelineSub) },
  { label: 'Client', value: d.client },
  { label: d.platformLabel ?? 'Platform', value: join(d.platform, d.platformSub) },
].filter((b) => b.value);
---
<div class="pf-top">
  <Heading class="pf-title" id={headingId}>{d.title}</Heading>
  <p class="t-answer pf-hook">{d.summary ?? d.subtitle}</p>
  <p class="pf-results">{d.results ?? d.short}</p>
</div>

<figure class="pf-stage">
  <Shot src={d.hero} demo={d.heroDemo} video={d.heroVideo} alt={d.alt.hero} placeholder={`Image 1 · hero on ${stageName} stage`} />
</figure>

{
  d.story ? (
    d.story.map((s) => (
      <>
        <section class="pf-sec">
          <span class="t-label pf-prompt">{s.label}</span>
          <p class="t-answer">{s.answer}</p>
        </section>
        {s.media && (
          <div class="pf-media">
            {s.media.map((m) =>
              m.demo ? <Demo name={m.demo} /> : m.src ? <img src={m.src} alt={m.alt ?? ''} loading="lazy" decoding="async" /> : null,
            )}
          </div>
        )}
      </>
    ))
  ) : (
    <>
      <section class="pf-sec">
        <span class="t-label pf-prompt">The problem I fell for</span>
        <p class="t-answer">{d.problem}</p>
      </section>
      <figure class="pf-pair">
        <div>
          <Shot src={d.before} alt={d.alt.before} placeholder="Image 2a · before" />
          <figcaption>Before</figcaption>
        </div>
        <div>
          <Shot src={d.after} alt={d.alt.after} placeholder="Image 2b · after" class="shot--after" />
          <figcaption>After</figcaption>
        </div>
      </figure>
      <section class="pf-sec">
        <span class="t-label pf-prompt">My role</span>
        <p class="t-answer">{d.role}</p>
      </section>
    </>
  )
}

<section class="pf-flag">
  <span class="t-label pf-prompt">Green flag</span>
  <div class="pf-flag__main">
    <span class="t-stat">{d.stat}</span>
    <span class="pf-flag__label">{d.statLabel}</span>
  </div>
  {
    d.flagItems && (
      <div class="pf-flag__items">
        {d.flagItems.map((f) => (
          <div>
            <span class="pf-flag__value">{f.value}</span>
            <span class="pf-flag__item-label">{f.label}</span>
          </div>
        ))}
      </div>
    )
  }
  {d.flagNote && <p class="pf-flag__note">{d.flagNote}</p>}
</section>

{
  d.flagMedia && (
    <div class="pf-media-row" style={`--n: ${d.flagMedia.length}`}>
      {d.flagMedia.map((m) => (
        <div><img src={m.src} alt={m.alt ?? ''} loading="lazy" decoding="async" /></div>
      ))}
    </div>
  )
}

{
  !d.story && (
    <figure class="pf-photo">
      <Shot src={d.photo} alt={d.alt.photo} placeholder={`Image 3 · photo graded to ${stageName}`} graded />
    </figure>
  )
}

<section class="pf-sec">
  <span class="t-label pf-prompt">{d.lessonLabel ?? 'What I’d do differently'}</span>
  <p class="t-answer">{d.lesson}</p>
</section>

<section class="pf-sec">
  <span class="t-label pf-prompt">The basics</span>
  <dl class="pf-basics">
    {
      basics.map((b) => (
        <div>
          <dt>{b.label}</dt>
          <dd>{b.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
