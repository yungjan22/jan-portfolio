---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import Handles from '../components/Handles.astro';
import Shot from '../components/Shot.astro';
import Profile from '../components/Profile.astro';
import { value, jobs, schools, projects, notes, skills } from '../data/resume';
import ExpEntry from '../components/ExpEntry.astro';
import { stageStyle } from '../lib/stage';

const work = (await getCollection('work', (e) => !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Rhythm: wide (4 cols) → small (left 2) + small (right 2) → wide → …
const cards = work.map((entry, i) => {
  const slot = i % 3;
  const span = slot === 0 ? 'all' : slot === 1 ? 'left' : 'right';
  return { entry, wide: slot === 0, span };
});

---
<Base>
  <div class="shell">
    <Panel />

    <main class="main" id="content">
      <div class="cols-wrap">
        <div class="cols" aria-hidden="true">
          <div class="c-l"></div><div class="c-l"></div><div class="c-r"></div><div class="c-r"></div>
        </div>

        <section class="section" id="work" aria-labelledby="work-h">
          <div class="section__head">
            <h2 class="t-h2" id="work-h">I design things that ship</h2>
          </div>
          <div class="work-grid">
            {
              cards.map(({ entry, wide, span }) => (
                <div class:list={['card sel', { 'card--wide': wide }]} data-span={span} style={stageStyle(entry)}>
                  <a
                    class="card__btn"
                    href={`/work/${entry.id}/`}
                    data-open={entry.id}
                    data-cursor={`View ${entry.data.title}`}
                    aria-haspopup="dialog"
                  >
                    <span class="card__img">
                      <Shot src={entry.data.hero} demo={entry.data.heroDemo} video={entry.data.heroVideo} alt={entry.data.alt.hero} placeholder="Project image" />
                    </span>
                    <span class="card__txt">
                      <span class="card__main">
                        <span class="card__title">{entry.data.title}</span>
                        <span class="card__desc">{wide ? entry.data.metric : entry.data.short}</span>
                      </span>
                      <span class="t-tag card__tag">
                        {entry.data.tag} · {entry.data.org} · {entry.data.year}
                      </span>
                    </span>
                  </a>
                  <Handles />
                </div>
              ))
            }
          </div>
        </section>

        <section class="section" id="value" aria-labelledby="value-h">
          <div class="section__head">
            <h2 class="t-h2" id="value-h">How I can help your team</h2>
          </div>
          <p class="section__lead">
            I lead end-to-end design as a tech-literate architect, prototyper and alignment facilitator.
          </p>
          {
            value.map((v) => (
              <div class="exp-row">
                <span class="exp-row__year">{v.label}</span>
                <span class="exp-row__org">{v.title}</span>
                <span class="exp-row__what">{v.text}</span>
              </div>
            ))
          }
        </section>

        <section class="section" id="experience" aria-labelledby="exp-h">
          <div class="section__head"><h2 class="t-h2" id="exp-h">Experience</h2></div>
          <div class="xp-grid">
            <div class="xp-col">
              <h3 class="t-label xp-group">Work</h3>
              <ul class="xp-list">{jobs.map((e) => <ExpEntry e={e} />)}</ul>
            </div>
            <div class="xp-col">
              <h3 class="t-label xp-group">School</h3>
              <ul class="xp-list">{schools.map((e) => <ExpEntry e={e} />)}</ul>
              <h3 class="t-label xp-group">Projects</h3>
              <ul class="xp-list">{projects.map((e) => <ExpEntry e={e} />)}</ul>
            </div>
          </div>
        </section>

        <section class="section" id="about" aria-labelledby="about-h">
          <div class="section__head"><h2 class="t-h2" id="about-h">About</h2></div>
          <div class="about">
            <div class="about__text">
              <p>
                Outside of Figma and front-end code, I’m an open-water swimmer, a plant parent and an
                avid picnicker.
              </p>
              <p>
                Engineering and business degrees in Taipei, then an MS in Human Centered Design &amp;
                Engineering at the University of Washington. I’m also a Toastmasters club president,
                so yes, I like meetings.
              </p>
            </div>
            <div class="about__notes">
              {notes.map((n) => (
                <div class="sticky"><b>{n.title}.</b> {n.text}</div>
              ))}
            </div>
            <dl class="skills">
              {skills.map((s) => (
                <div><dt class="t-label">{s.name}</dt><dd>{s.items}</dd></div>
              ))}
            </dl>
          </div>
        </section>
      </div>
    </main>
  </div>

  <dialog class="lightbox" aria-labelledby="lb-title-0">
    <Handles badge={false} />
    <div class="lb-head">
      <span class="t-label" style="font-variant-numeric: tabular-nums">
        Project profile · <span data-pos>1</span> / {work.length}
      </span>
      <button class="lb-close" type="button" data-close aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" stroke="currentColor" stroke-width="1.6" fill="none"><path d="M2 2l10 10M12 2L2 12"></path></svg>
      </button>
    </div>
    <div class="lb-body" data-lb-body>
      {
        work.map((entry, i) => {
          const next = work[(i + 1) % work.length];
          return (
            <article data-profile={entry.id} hidden={i !== 0} style={stageStyle(entry)}>
              <Profile entry={entry} headingId={`lb-title-${i}`} />
              <div class="pf-foot">
                <button class="next-link" type="button" data-next={next.id} data-cursor={`Next: ${next.data.title}`}>
                  <span>Next profile</span>
                  <span>{next.data.title} →</span>
                </button>
              </div>
            </article>
          );
        })
      }
    </div>
  </dialog>

  <script>
    import '../scripts/home';
  </script>
</Base>
